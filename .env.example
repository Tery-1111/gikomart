# GikoMart — required environment variables
#
# Copy this file to .env and fill in real values:
#
#   cp .env.example .env
#
# Every value below is an obvious placeholder. Never commit real credentials —
# .env is gitignored, this file is not.
#
# server.js loads .env via dotenv at startup, so these only apply to the Node
# process (and to npm scripts, which inherit it).

# ─── Server ─────────────────────────────────────────────────────────────────
# Runtime environment. 'production' switches the error handler to prod-style
# bodies and enables JSON logs; 'test' silences the logger.
NODE_ENV=development
# Port the Express server listens on (defaults to 5000).
PORT=5000
# Number of proxy hops in front of the app. 1 for Render alone. Set to 2 when Cloudflare proxies traffic.
TRUST_PROXY=1
# Public base URL of this deployment. Sent to IntaSend as the STK-push callback
# host, so it must be reachable from the internet in production.
APP_URL=https://example.com

# ─── Database ───────────────────────────────────────────────────────────────
# MongoDB connection string (Atlas URI in production).
MONGO_URI=mongodb://localhost:27017/gikomart

# ─── Auth ───────────────────────────────────────────────────────────────────
# Production secrets must be at least 16 characters (server.js refuses to start
# otherwise): ADMIN_KEY, ADMIN_SESSION_SECRET and INTASEND_WEBHOOK_CHALLENGE.
# Bootstrap admin key, presented as the X-Admin-Key header. Grants admin access
# until TOTP 2FA is enrolled, so rotate it after enrolling.
ADMIN_KEY=changeme
# Secret used to sign admin session tokens (X-Admin-Session). Rotating it
# invalidates every issued session.
ADMIN_SESSION_SECRET=changeme

# ─── Payments (IntaSend) ────────────────────────────────────────────────────
INTASEND_PUBLISHABLE_KEY=ISPubKey_test_changeme
INTASEND_SECRET_KEY=ISSecretKey_test_changeme
# 'true' sends IntaSend API calls to their sandbox.
INTASEND_TEST_MODE=true
# Shared challenge IntaSend echoes in webhook bodies. Requests carrying any
# other value are rejected with 401.
INTASEND_WEBHOOK_CHALLENGE=changeme

# ─── WhatsApp (Whapi.Cloud) ─────────────────────────────────────────────────
# Bearer token for the Whapi.Cloud API used to broadcast listings to groups.
WHAPI_TOKEN=changeme
# Comma-separated WhatsApp group IDs that listings are broadcast to.
WHATSAPP_GROUPS=120363000000000000@g.us,120363000000000001@g.us

# ─── Cloudinary ─────────────────────────────────────────────────────────────
# Image storage for listing photos.
CLOUDINARY_CLOUD_NAME=changeme
CLOUDINARY_API_KEY=changeme
CLOUDINARY_API_SECRET=changeme

# ─── Analytics ──────────────────────────────────────────────────────────────
# No environment variables. The GoatCounter site code and the PostHog project
# key are hardcoded in public/index.html.

# ─── Ops ────────────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed by CORS. Defaults to
# https://gikomart.onrender.com,http://localhost:5000 when unset.
CORS_ORIGINS=https://example.com,http://localhost:5000
